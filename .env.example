# Fixtures locais, sem backend. Para usar Supabase, remova estas duas opções
# e configure VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY no .env ignorado.
# Com URL/chave presentes e sem VITE_DATA_MODE, a aplicação seleciona Supabase.
VITE_DATA_MODE=demo
VITE_DEMO_MODE=true
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<chave-publica>
